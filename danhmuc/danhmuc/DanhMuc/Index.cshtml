@model IEnumerable<DanhMucMonAn>
@{ ViewData["Title"] = "Danh mục món ăn"; }
<div class="page-heading">
    <div><h1>Danh mục món ăn</h1><p>Quản lý nhóm món trong thực đơn.</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm danh mục</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body border-bottom">
        <form method="get" class="row g-2"><div class="col-md-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm tên danh mục..." /></div><div class="col-auto"><button class="btn btn-outline-primary">Tìm kiếm</button></div></form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>#</th><th>Tên danh mục</th><th>Mô tả</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaDanhMuc</td><td class="fw-semibold">@item.TenDanhMuc</td><td>@item.MoTa</td>
                    <td><span class="badge @(item.TrangThai ? "text-bg-success" : "text-bg-secondary")">@(item.TrangThai ? "Đang dùng" : "Ngừng dùng")</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MaDanhMuc"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Toggle" asp-route-id="@item.MaDanhMuc" method="post" class="d-inline" data-confirm="Đổi trạng thái danh mục này?">
                            <button class="btn btn-sm btn-outline-warning" title="Đổi trạng thái"><i class="bi bi-power"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
