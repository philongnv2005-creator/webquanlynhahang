@model CreateOrderViewModel
@{ ViewData["Title"] = "Tạo đơn gọi món"; }
<div class="page-heading"><div><h1>Tạo đơn gọi món</h1><p>Mỗi bàn chỉ có tối đa một đơn đang hoạt động.</p></div></div>
<div class="card border-0 shadow-sm form-card"><div class="card-body p-4"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="MaBan" class="form-label"></label><select asp-for="MaBan" asp-items="ViewBag.Tables" class="form-select"><option value="">-- Chọn bàn --</option></select><span asp-validation-for="MaBan" class="text-danger"></span></div><div class="mb-4"><label asp-for="MaKhachHang" class="form-label"></label><select asp-for="MaKhachHang" asp-items="ViewBag.Customers" class="form-select"><option value="">Khách vãng lai</option></select></div><button class="btn btn-primary">Tạo đơn</button><a class="btn btn-light" asp-action="Index">Quay lại</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
