@model IEnumerable<NguoiDung>
@{ ViewData["Title"] = "Tài khoản"; }
<div class="page-heading"><div><h1>Quản lý tài khoản</h1><p>Tạo tài khoản, phân vai trò và khóa/mở khóa người dùng.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus me-1"></i>Tạo tài khoản</a></div>
<div class="card border-0 shadow-sm"><div class="card-body border-bottom"><form method="get" class="row g-2"><div class="col-md-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm tên đăng nhập hoặc họ tên..." /></div><div class="col-auto"><button class="btn btn-outline-primary">Tìm kiếm</button></div></form></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Vai trò</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="fw-semibold">@item.TenDangNhap</td><td>@item.HoTen</td><td><span class="badge text-bg-light border">@item.VaiTro?.TenVaiTro</span></td><td><span class="badge @(item.TrangThai ? "text-bg-success" : "text-bg-secondary")">@(item.TrangThai ? "Hoạt động" : "Bị khóa")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MaNguoiDung"><i class="bi bi-pencil"></i></a></td></tr>}</tbody></table></div></div>
