@model DanhMucMonAn
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="mb-3"><label asp-for="TenDanhMuc" class="form-label"></label><input asp-for="TenDanhMuc" class="form-control" /><span asp-validation-for="TenDanhMuc" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" class="form-control" rows="3"></textarea><span asp-validation-for="MoTa" class="text-danger small"></span></div>
<div class="form-check mb-4"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label"></label></div>
<button class="btn btn-primary" type="submit"><i class="bi bi-save me-1"></i>Lưu</button>
<a class="btn btn-light" asp-action="Index">Quay lại</a>
