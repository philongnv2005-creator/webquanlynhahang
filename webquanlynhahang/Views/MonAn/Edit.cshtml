<div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Edit" asp-route-id="@Model.MaMon" method="post" enctype="multipart/form-data"><input asp-for="MaMon" type="hidden" /><input asp-for="HinhAnhHienTai" type="hidden" /><partial name="_Form" model="Model" /></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
