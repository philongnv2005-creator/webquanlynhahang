@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="page-heading"><div><h1>Đổi mật khẩu</h1><p>Cập nhật mật khẩu đăng nhập cá nhân.</p></div></div>
<div class="card border-0 shadow-sm form-card"><div class="card-body p-4">
<form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="MatKhauCu" class="form-label"></label><input asp-for="MatKhauCu" class="form-control" /><span asp-validation-for="MatKhauCu" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="MatKhauMoi" class="form-label"></label><input asp-for="MatKhauMoi" class="form-control" /><span asp-validation-for="MatKhauMoi" class="text-danger"></span></div>
    <div class="mb-4"><label asp-for="XacNhanMatKhau" class="form-label"></label><input asp-for="XacNhanMatKhau" class="form-control" /><span asp-validation-for="XacNhanMatKhau" class="text-danger"></span></div>
    <button class="btn btn-primary">Lưu mật khẩu</button><a class="btn btn-light" asp-controller="Home" asp-action="Dashboard">Hủy</a>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
