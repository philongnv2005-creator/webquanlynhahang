@model PaymentViewModel
@{
    ViewData["Title"] = "Thanh toán";
    var order = ViewBag.Order as DonGoiMon;
}
<div class="page-heading"><div><h1>Thanh toán đơn #@Model.MaDon</h1><p>@order?.BanAn?.TenBan · @(order?.KhachHang?.HoTen ?? "Khách vãng lai")</p></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-header bg-white py-3"><h5 class="mb-0">Kiểm tra món</h5></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Món</th><th class="text-center">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead><tbody>@if(order!=null){foreach(var item in order.ChiTietDonGoiMons.Where(x=>x.TrangThaiMon!=TrangThaiMonTrongDon.DaHuy)){<tr><td>@item.MonAn?.TenMon</td><td class="text-center">@item.SoLuong</td><td class="text-end">@item.DonGia.ToString("N0") đ</td><td class="text-end fw-semibold">@item.ThanhTien.ToString("N0") đ</td></tr>}}</tbody><tfoot><tr><th colspan="3" class="text-end">Tổng tiền</th><th class="text-end text-danger fs-5">@Model.TongTien.ToString("N0") đ</th></tr></tfoot></table></div></div></div>
<div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Pay" method="post"><input asp-for="MaDon" type="hidden" /><input asp-for="TongTien" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="GiamGia" class="form-label"></label><div class="input-group"><input asp-for="GiamGia" class="form-control" /><span class="input-group-text">đ</span></div><span asp-validation-for="GiamGia" class="text-danger small"></span></div><div class="mb-4"><label asp-for="PhuongThuc" class="form-label"></label><select asp-for="PhuongThuc" asp-items="Html.GetEnumSelectList<PhuongThucThanhToan>()" class="form-select"></select></div><div class="alert alert-light border d-flex justify-content-between"><span>Khách cần trả</span><strong id="payable" class="text-danger">@Model.TongTien.ToString("N0") đ</strong></div><button class="btn btn-success btn-lg w-100" data-confirm="Xác nhận đã nhận thanh toán?"><i class="bi bi-check2-circle me-2"></i>Xác nhận thanh toán</button></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>const total=@Model.TongTien.ToString(System.Globalization.CultureInfo.InvariantCulture);const discount=document.getElementById('GiamGia');const payable=document.getElementById('payable');discount?.addEventListener('input',()=>{const value=Math.max(0,total-(parseFloat(discount.value)||0));payable.textContent=new Intl.NumberFormat('vi-VN').format(value)+' đ';});</script> }
