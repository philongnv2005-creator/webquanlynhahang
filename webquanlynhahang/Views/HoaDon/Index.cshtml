@model IEnumerable<HoaDon>
@{ ViewData["Title"] = "Hóa đơn"; }
<div class="page-heading"><div><h1>Lịch sử hóa đơn</h1><p>Tra cứu các giao dịch thanh toán.</p></div><a class="btn btn-primary" asp-action="Pending">Đơn chờ thanh toán</a></div>
<div class="card border-0 shadow-sm"><div class="card-body border-bottom"><form method="get" class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">Từ ngày</label><input type="date" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" class="form-control" /></div><div class="col-md-3"><label class="form-label">Đến ngày</label><input type="date" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" class="form-control" /></div><div class="col-auto"><button class="btn btn-outline-primary">Lọc</button></div></form></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Mã HĐ</th><th>Ngày thanh toán</th><th>Bàn</th><th>Thu ngân</th><th>Phương thức</th><th class="text-end">Tổng tiền</th><th class="text-end">Giảm giá</th><th class="text-end">Thành tiền</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="fw-bold">#@item.MaHoaDon</td><td>@item.NgayThanhToan.ToString("dd/MM/yyyy HH:mm")</td><td>@item.DonGoiMon?.BanAn?.TenBan</td><td>@item.NhanVien?.HoTen</td><td>@item.PhuongThuc.GetDisplayName()</td><td class="text-end">@item.TongTien.ToString("N0") đ</td><td class="text-end">@item.GiamGia.ToString("N0") đ</td><td class="text-end fw-semibold text-success">@item.ThanhTien.ToString("N0") đ</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.MaHoaDon">Xem</a></td></tr>}</tbody></table></div></div>
