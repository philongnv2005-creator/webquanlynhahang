@model IEnumerable<BanAn>
@{ ViewData["Title"] = "Bàn ăn"; }
<div class="page-heading">
    <div><h1>Sơ đồ bàn ăn</h1><p>Theo dõi nhanh trạng thái và sức chứa của từng bàn.</p></div>
    @if (User.IsInRole(RoleNames.QuanTriVien) || User.IsInRole(RoleNames.QuanLy))
    { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm bàn</a> }
</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><form method="get" class="row g-2"><div class="col-md-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm theo tên bàn hoặc khu vực..." /></div><div class="col-auto"><button class="btn btn-outline-primary">Tìm kiếm</button></div></form></div></div>
<div class="d-flex flex-wrap gap-3 mb-3 small">
    <span><i class="status-dot status-empty"></i>Trống</span><span><i class="status-dot status-reserved"></i>Đã đặt</span><span><i class="status-dot status-serving"></i>Đang phục vụ</span><span><i class="status-dot status-payment"></i>Chờ thanh toán</span><span><i class="status-dot status-disabled"></i>Ngừng sử dụng</span>
</div>
<div class="row g-3">
@foreach (var item in Model)
{
    var css = item.TrangThai switch { TrangThaiBan.Trong => "table-empty", TrangThaiBan.DaDat => "table-reserved", TrangThaiBan.DangPhucVu => "table-serving", TrangThaiBan.ChoThanhToan => "table-payment", _ => "table-disabled" };
    <div class="col-6 col-md-4 col-xl-2">
        <div class="restaurant-table @css h-100">
            <div class="d-flex justify-content-between"><i class="bi bi-grid-3x3-gap fs-3"></i><span class="badge bg-white text-dark">@item.SoCho chỗ</span></div>
            <h5 class="mt-3 mb-1">@item.TenBan</h5><p class="mb-2 small">@item.KhuVuc</p><strong>@item.TrangThai.GetDisplayName()</strong>
            @if (User.IsInRole(RoleNames.QuanTriVien) || User.IsInRole(RoleNames.QuanLy))
            { <div class="mt-3"><a class="btn btn-sm btn-light w-100" asp-action="Edit" asp-route-id="@item.MaBan">Chỉnh sửa</a></div> }
        </div>
    </div>
}
</div>
