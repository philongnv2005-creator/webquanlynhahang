@model IEnumerable<MonAn>
@{ ViewData["Title"] = "Món ăn"; }
<div class="page-heading">
    <div><h1>Quản lý món ăn</h1><p>Cập nhật thực đơn, giá bán, hình ảnh và trạng thái kinh doanh.</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm món ăn</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body border-bottom">
        <form method="get" class="row g-2">
            <div class="col-md-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm tên món..." /></div>
            <div class="col-md-4"><select name="categoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Tất cả danh mục</option></select></div>
            <div class="col-auto"><button class="btn btn-outline-primary">Lọc</button></div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Ảnh</th><th>Tên món</th><th>Danh mục</th><th class="text-end">Đơn giá</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@if (!string.IsNullOrWhiteSpace(item.HinhAnh)){<img src="@item.HinhAnh" class="table-thumb" alt="@item.TenMon" />}else{<div class="table-thumb placeholder-thumb"><i class="bi bi-image"></i></div>}</td>
                    <td><div class="fw-semibold">@item.TenMon</div><small class="text-secondary text-truncate d-inline-block" style="max-width:300px">@item.MoTa</small></td>
                    <td>@item.DanhMucMonAn?.TenDanhMuc</td>
                    <td class="text-end fw-semibold">@item.DonGia.ToString("N0") đ</td>
                    <td><span class="badge @(item.TrangThai == TrangThaiMonAn.DangKinhDoanh ? "text-bg-success" : "text-bg-secondary")">@item.TrangThai.GetDisplayName()</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MaMon"><i class="bi bi-pencil"></i></a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
